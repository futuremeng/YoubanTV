<?xml version="1.0" encoding="utf-8"?>
<!-- 电视端（tv 装配）最小闭环壳层：M3。
     呈现按 docs/LAYERING.md §4 那一处规则；这里不出现连续、成就、催促（docs/PRODUCT.md §2）。
     输入通路是这层存在的理由：遥控器按键在这里落到设备上（facts/DEVICES.md#F16）。 -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.youban.tv"
    android:versionCode="1"
    android:versionName="0.1-m3">

    <uses-sdk android:minSdkVersion="19" android:targetSdkVersion="28" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- 现在这一版一条权限都不声明：L2 悬浮层还没做，做的那天再声明；
         后台常驻与开机自启这两条路压根不许有。声明了却没用＝白要权限，
         清单里每一条的交代在契约 devicePermissions 那一处（ONBOARD-06）。 -->

    <application
        android:allowBackup="false"
        android:label="@string/app_label">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.youban.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <receiver
            android:name=".StateReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.youban.STATE" />
            </intent-filter>
        </receiver>
    </application>
</manifest>

{
  "protocolVersion": 1,
  "x-note": "契约单一来源（D1、M1.1）。面板客户端与设备端 DTO 由本文件生成；本文件之外的字段即「契约里无定义」，代码不得凭直觉补。每条都带 spec 指向规格条目，CI 用它做引用完整性检查。",

  "principal": {
    "kind": "member",
    "form": "member:<id>",
    "spec": ["PROFILE-08", "AUTO-10"],
    "x-note": "全体成员同一主体；契约里不存在 parent 主体，也不存在按 audience 的权限字段（PROFILE-01/02）。"
  },

  "roles": {
    "values": ["ruleEditor", "keyHolder"],
    "cardinality": "每类角色同一时刻各一人，可轮值",
    "grantPath": "本机当前激活模式内的两次确认：持有人提 roleChange 动议，对方在自己的界面受理",
    "keyHolderTransfer": "必须在被控设备本机由现任当场确认，不接受远程受理",
    "derivedFrom": [],
    "spec": ["AUTO-07", "AUTO-09", "AUTO-10", "PROFILE-01", "PROFILE-10"]
  },

  "scopes": {
    "values": ["read", "rules", "content", "grade", "diagnostics", "egress"],
    "grants": {
      "ruleEditor": ["read", "rules", "content", "grade", "diagnostics"],
      "keyHolder": ["egress"]
    },
    "x-note": "发起动议不需要 scope；受理不是权限，它只发生在被请求方自己的界面。grade 为查阅与修订，不含「先批完才入账」这类开关。",
    "spec": ["AUTO-10", "AUTO-15", "ARCHITECTURE-§5"]
  },

  "pairing": {
    "keyBinding": "设备 / 面板凭据（不随角色轮值转移）",
    "token": "短时令牌（scope + TTL）；改密码或重启令全部失效；配对后密码只用于签发",
    "unauthenticatedEndpoints": ["/api/hello"],
    "spec": ["ARCHITECTURE-§5", "D11", "D38"]
  },

  "endpoints": [
    {
      "method": "GET",
      "path": "/api/hello",
      "auth": "none",
      "response": ["model", "protocolVersion", "paired", "capabilities"],
      "spec": ["ARCHITECTURE-§5"]
    },
    {
      "method": "GET",
      "path": "/api/me",
      "auth": "member",
      "reads": ["账本视图（与面板同源）", "生效约定", "待受理动议", "当前协商强度", "当前层", "伴看上下文开关状态"],
      "spec": ["AUTO-06", "AUTO-10"]
    },
    {
      "method": "PUT",
      "path": "/api/myPlan",
      "auth": "member",
      "writes": ["selfManagedFields（任何强度下）", "dayPlan（仅自管强度下的本人）"],
      "readOnlyForOthers": ["selfManagedFields"],
      "spec": ["AUTO-14", "AUTO-07", "PROFILE-08"]
    },
    {
      "method": "POST",
      "path": "/api/me/purge",
      "auth": "member",
      "effect": "清除自己的记录；家庭协议与他人账本各自独立；写一条审计事件",
      "spec": ["AUTO-06"]
    },
    {
      "method": "POST",
      "path": "/api/motions",
      "auth": "member",
      "body": ["kind", "target", "terms", "reason"],
      "ttlMs": 86400000,
      "cooldownMs": 1800000,
      "x-note": "申诉、即时控制、角色交接、共看邀请共用这一条端点；受理由被请求方在自己的界面完成。",
      "spec": ["AUTO-03", "AUTO-16", "D34"]
    },
    {
      "method": "GET",
      "path": "/api/simulate",
      "auth": "read",
      "x-note": "计划模拟器，调用内核同一份决策代码（M4）。",
      "spec": ["ROADMAP-M4"]
    },
    {
      "method": "GET",
      "path": "/api/topics",
      "auth": "read",
      "spec": ["ASK-02", "ROADMAP-M5"]
    },
    {
      "method": "POST",
      "path": "/api/exercise",
      "auth": "member",
      "body": ["taskId", "signalSource"],
      "spec": ["COMMIT-03"]
    },
    {
      "method": "POST",
      "path": "/api/cowatch",
      "auth": "member",
      "x-note": "共看时段与邀请；邀请即 kind=coWatch 的动议。",
      "spec": ["AUTO-03", "MOBILE-§2"]
    },
    {
      "method": "POST",
      "path": "/api/messages",
      "auth": "member",
      "body": ["text", "at", "author"],
      "x-note": "家人原话原样送达，来源标注到人。",
      "spec": ["MOBILE-§2", "LAYER-09"]
    }
  ],

  "enums": {
    "tier": {
      "values": ["L0", "L1", "L1.5", "L2", "L3", "L5"],
      "reserved": ["L4"],
      "spec": ["LAYER-01", "D15", "D23"]
    },
    "status": { "values": ["honored", "due", "overdue"], "spec": ["COMMIT-09"] },
    "mode": { "values": ["focused", "ambient"], "spec": ["COMMIT-02", "COMMIT-03"] },
    "nextAction": {
      "values": ["quiz", "exercise", "free", "motion", "none"],
      "spec": ["GATE-别名退役"]
    },
    "dueKind": { "values": ["quiz", "exercise", "free"], "spec": ["COMMIT-02", "COMMIT-03"] },
    "motionKind": {
      "values": ["pause", "extend", "stopHint", "cancelTask", "changeTask", "slotChange", "planChange", "dataExport", "roleChange", "coWatch"],
      "quotaPerMemberPerDay": {
        "pause": 3,
        "extend": 2,
        "stopHint": 1,
        "cancelTask": 1,
        "changeTask": 1,
        "slotChange": 1,
        "planChange": null,
        "dataExport": null,
        "roleChange": null,
        "coWatch": null
      },
      "extendMaxMinutes": 15,
      "spec": ["AUTO-03"]
    },
    "event": {
      "values": [
        "WATCHED", "DONE", "ANSWER", "ROUND_DONE", "OVER", "MISSED",
        "PLAN_SIGNED", "PLAN_CHANGE", "PROFILE_SWITCH",
        "MOTION", "MOTION_SETTLED", "MOTION_UNANSWERED",
        "REVISION", "ROLE_CHANGE", "REMOTE"
      ],
      "requiredFields": { "all": ["at", "profile", "device"] },
      "profileDomain": ["member:<id>", "none"],
      "spec": ["PRODUCT-§3", "PROFILE-04", "COMMIT-11"]
    },
    "knowledgeState": {
      "values": ["unseen", "learning", "shaky", "weak", "mastered"],
      "spec": ["ASK-03", "PRODUCT-§5"]
    },
    "gradedBy": { "values": ["self", "ai"], "spec": ["AUTO-15"] },
    "signalSource": { "values": ["manual", "sensor"], "spec": ["COMMIT-03", "SENSE-02"] },
    "exerciseVerdict": { "values": ["counted", "ambiguous", "rejected"], "spec": ["COMMIT-03", "SENSE-04"] },
    "audience": { "values": ["child", "grown-up", "senior"], "spec": ["PACK-01", "PROFILE-01"] },
    "presentation": {
      "values": ["standard", "large"],
      "uiWords": { "standard": "标准", "large": "大字" },
      "spec": ["PROFILE-09", "NAMING-§5"]
    },
    "strength": {
      "values": ["accompanied", "negotiated", "selfManaged"],
      "uiWords": { "accompanied": "陪伴式", "negotiated": "协商式", "selfManaged": "自管式" },
      "defaultTierOnDue": { "accompanied": "L3", "negotiated": "L2", "selfManaged": "L1" },
      "spec": ["AUTO-07", "LAYER-07"]
    },
    "presence": { "values": ["alone", "co-present", "co-watch"], "spec": ["SENSE-07", "COMMITMENTS-§4b"] }
  },

  "profile": {
    "fields": ["id", "label", "audience", "content.packs", "content.outlineScope", "content.exerciseTasks", "defaults.mode", "defaults.schedulePrefs", "defaults.presentation"],
    "rolesField": "roles 住在成员身上，不在 Profile 里（PROFILE-01）",
    "spec": ["PROFILE-01"]
  },

  "selfManagedFields": {
    "values": ["groupsPerTask", "questionsPerGroup", "questionsPerTaskCap", "clearBacklogFirst"],
    "writePath": "PUT /api/myPlan（仅本人）",
    "writePathsForOthers": [],
    "inTighteningComparison": false,
    "uiWords": {
      "groupsPerTask": "组数",
      "questionsPerGroup": "每组题量",
      "questionsPerTaskCap": "每次任务的题目数上限",
      "clearBacklogFirst": "补一补是否先补完"
    },
    "spec": ["AUTO-14", "DAY-05", "ASK-04", "ASK-07"]
  },

  "forbiddenFields": {
    "values": [
      "allowanceCeiling",
      "ageLimit",
      "selfManageRequiresAge",
      "featureToggleByAudience",
      "grantMinutes",
      "unlocked",
      "unspentMs",
      "verdict",
      "phase",
      "doneMs"
    ],
    "x-note": "这些字段在契约里无定义：完成只写事件，不发放也不兑换时长；能力对所有成员相同；按 audience 的开关与上限不存在。",
    "spec": ["AUTO-13", "COMMIT-05", "PROFILE-03", "D24", "GATE-别名退役"]
  },

  "writeGuards": {
    "profileParameter": "写入口的 profile 参数只能取当前激活身份或 none",
    "noCrossMemberWrite": true,
    "enforcementSurface": ["present()"],
    "spec": ["PROFILE-10", "COMMIT-10", "AUTO-16"]
  },

  "retired": {
    "principals": ["parent"],
    "scopes": ["control"],
    "endpoints": ["POST /api/requests"],
    "events": ["REQUEST", "REQUEST_SETTLED"],
    "nextAction": ["request"],
    "aliases": { "parent": "member:<id> + roles", "REQUEST": "MOTION", "REQUEST_SETTLED": "MOTION_SETTLED", "request": "motion", "control": "已受理的动议 + roles" },
    "spec": ["GATE-别名退役"]
  }
}
